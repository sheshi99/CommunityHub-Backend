# Puerto en el que corre el servidor
PORT=3000

# Origenes permitidos por CORS, separados por comas
FRONTEND_URLS=http://localhost:3001

# Zona horaria de las actividades expresada como offset ISO 8601
EVENT_TIMEZONE_OFFSET=-06:00

# Cadena de conexion a MongoDB (local o Atlas)
MONGODB_URI=mongodb://localhost:27017/communityhub

# Secreto utilizado para firmar los JSON Web Tokens
JWT_SECRET=

# Tiempo de expiracion de los JWT (ej: 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# Integracion asincrona con la Lambda externa de notificaciones
AWS_REGION=us-east-1
AWS_LAMBDA_CAPACITY_FUNCTION_NAME=
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key

# Solo para scripts/seed-dashboard.js: emails de 3 cuentas YA EXISTENTES en tu
# base local, una por rol, usadas para poblar datos de prueba de los dashboards.
SEED_ADMIN_EMAIL=
SEED_ORGANIZER_EMAIL=
SEED_USER_EMAIL=
